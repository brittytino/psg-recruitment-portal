# Production HTTPS server block (copy to default.conf on the VPS and adjust server_name).
# Certificates: certbot (webroot) mounted at /etc/letsencrypt. See docs/deployment/vps-deployment.md.
server {
    listen 80;
    server_name recruitment.example.edu;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name recruitment.example.edu;
    ssl_certificate     /etc/letsencrypt/live/recruitment.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/recruitment.example.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 12m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    location = /healthz/ready { allow 127.0.0.1; deny all; proxy_pass http://app_active; }
    location / { proxy_pass http://app_active; include /etc/nginx/proxy_params.conf; }
}
