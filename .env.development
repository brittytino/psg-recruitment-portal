# ---------------------------------------------------------------------------
# PSG Staff Recruitment Portal — DEVELOPMENT & DEMO ENVIRONMENT CONFIGURATION
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public URL used in e-mails and Origin checks.
APP_ORIGIN=http://localhost:6969
ALLOWED_ORIGINS=http://localhost:6969,http://127.0.0.1:6969,http://localhost:3000,http://127.0.0.1:3000

# Host ports for local debugging and host GUI tools.
APP_HOST_PORT=6969
POSTGRES_HOST_PORT=6543
REDIS_HOST_PORT=63879
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=2525
CONVERTER_HOST_PORT=63100
DB_VIEWER_HOST_PORT=6981
DB_VIEWER_USER=
DB_VIEWER_PASSWORD=
ADMINER_HOST_PORT=6981

# PostgreSQL credentials & connection strings
POSTGRES_DB=srportal
POSTGRES_USER=srp_owner
POSTGRES_PASSWORD=PsgTech_DbOwner_2026!
APP_DB_USER=srp_app
APP_DB_PASSWORD=PsgTech_AppUser_2026!
DATABASE_URL=postgresql://srp_app:PsgTech_AppUser_2026!@db:5432/srportal?schema=public
MIGRATION_DATABASE_URL=postgresql://srp_owner:PsgTech_DbOwner_2026!@db:5432/srportal?schema=public

REDIS_URL=redis://redis:6379

# Session secret (>= 32 chars). Cryptographically strong random key for session & CSRF tokens.
SESSION_SECRET=e7b8a1c93f0d4529b68a4e1f7c2d8b5a9034ecbf186241a7d903e15b497c28fa
# Cookies should NOT be marked Secure over plain HTTP (localhost / demo).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Private document storage (container path, backed by a named volume).
STORAGE_DIR=/var/lib/srportal/storage
MAX_UPLOAD_MB=10

# Internal services
CONVERTER_URL=http://converter:3100
CONVERTER_TOKEN=c3f1b8a9d04e762b9a15cd82ef04b971
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# E-mail (Mailpit web UI at http://localhost:8025, SMTP at localhost:2525)
EMAIL_PROVIDER=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="PSG College of Technology Recruitment"
SMTP_FROM_EMAIL=recruitments@psgtech.ac.in
MAIL_FROM="PSG College of Technology Recruitment <recruitments@psgtech.ac.in>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# 6-Digit Email OTP Authentication Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

LOG_LEVEL=info
DEV_LOG_OTP=true
