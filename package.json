{
  "name": "psg-staff-recruitment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0 --port 3000",
    "build": "react-router build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=build-worker/index.js",
    "start": "react-router-serve ./build/server/index.js",
    "worker": "tsx worker/index.ts",
    "worker:prod": "node build-worker/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:pdf": "vitest run --project pdf",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "forms:inventory": "tsx scripts/extract-inventory.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@xmldom/xmldom": "0.9.12",
    "bullmq": "5.81.5",
    "clsx": "2.1.1",
    "file-type": "22.2.0",
    "ioredis": "5.11.1",
    "isbot": "5.2.2",
    "jszip": "3.10.2",
    "lucide-react": "1.58.0",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
