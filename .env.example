# ---------------------------------------------------------------------------
# PSG Staff Recruitment Portal — ENVIRONMENT CONFIGURATION TEMPLATE
# ---------------------------------------------------------------------------

# Public URL used in e-mails and Origin checks (change to https://recruitments.psgtech.ac.in on server).
APP_ORIGIN=https://recruitments.psgtech.ac.in

# Host ports (local development and server proxies)
APP_HOST_PORT=6969
POSTGRES_HOST_PORT=6543
REDIS_HOST_PORT=63879
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=2525
CONVERTER_HOST_PORT=63100
ADMINER_HOST_PORT=6981

# PostgreSQL credentials & connection strings
POSTGRES_DB=srportal
POSTGRES_USER=srp_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_USER=srp_app
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://srp_app:change-me-app@db:5432/srportal?schema=public
MIGRATION_DATABASE_URL=postgresql://srp_owner:change-me-owner@db:5432/srportal?schema=public

REDIS_URL=redis://redis:6379

# Session secret (>= 32 chars). Cryptographically strong random key for session & CSRF tokens.
SESSION_SECRET=20b98afbbe9a9a92bfc49cbca1ea245b1926da16be5608ce472e9a9ec6ca3386
# Mark cookies Secure (MUST be true behind HTTPS in production, false for localhost HTTP).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Private document storage (container path, backed by a named volume).
STORAGE_DIR=/var/lib/srportal/storage
MAX_UPLOAD_MB=10

# Internal services
CONVERTER_URL=http://converter:3100
CONVERTER_TOKEN=Pin8esdf5Fbx61-NgxhyXVruzuam0wdF
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# E-mail Configuration
# EMAIL_PROVIDER: "mailpit" for local development, "smtp" for production, "test" for automated tests.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE: true for SSL on port 465; false for STARTTLS on port 587 or plain Mailpit.
SMTP_SECURE=false
# Institutional recruitment mailbox
SMTP_USER=recruitments@psgtech.ac.in
SMTP_PASSWORD=rdyu fhbs megh sgid
SMTP_FROM_NAME="PSG College of Technology Recruitment"
SMTP_FROM_EMAIL=recruitments@psgtech.ac.in
MAIL_FROM="PSG College of Technology Recruitment <recruitments@psgtech.ac.in>"
# Timeouts in milliseconds
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# 6-Digit Email OTP Authentication Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

LOG_LEVEL=info
DEV_LOG_OTP=false
