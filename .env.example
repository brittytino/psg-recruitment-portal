# ---------------------------------------------------------------------------
# PSG Staff Recruitment Portal — environment configuration (copy to .env)
# Never commit .env. Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# Host ports (local development only; production publishes only Nginx 80/443).
APP_HOST_PORT=6969
POSTGRES_HOST_PORT=65432
REDIS_HOST_PORT=63879
MAILPIT_UI_HOST_PORT=6980
CONVERTER_HOST_PORT=63100

# Public URL used in e-mails and Origin checks.
APP_ORIGIN=http://localhost:6969

# PostgreSQL. The application connects as the least-privilege "srp_app" role; migrations run
# as the owner role. Both roles are created by infrastructure/docker/postgres/init.sh.
POSTGRES_DB=srportal
POSTGRES_USER=srp_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_USER=srp_app
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://srp_app:change-me-app@db:5432/srportal?schema=public
MIGRATION_DATABASE_URL=postgresql://srp_owner:change-me-owner@db:5432/srportal?schema=public

REDIS_URL=redis://redis:6379

# Session secret (>= 32 chars). Used to sign CSRF tokens.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Mark cookies Secure. Must be true behind HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Private document storage (container path, backed by a named volume).
STORAGE_DIR=/var/lib/srportal/storage
MAX_UPLOAD_MB=10

# Internal services
CONVERTER_URL=http://converter:3100
CONVERTER_TOKEN=replace-with-random-token
# clamav = scan with clamd; "disabled" is only allowed when NODE_ENV != production and marks
# every attachment as FAILED scan so bundles cannot be completed silently.
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# E-mail (local development uses Mailpit at http://localhost:6980)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PSG Tech Recruitment <recruitment@localhost>"

LOG_LEVEL=info
# Development only: also print e-mailed sign-in codes to the server log. Rejected when NODE_ENV=production.
DEV_LOG_OTP=false
