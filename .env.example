# ---------------------------------------------------------------------------
# PSG Staff Recruitment Portal — environment configuration (copy to .env)
# Never commit .env. Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# Host ports (local development only; production publishes only Nginx 80/443).
APP_HOST_PORT=6969
POSTGRES_HOST_PORT=6543
REDIS_HOST_PORT=63879
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=2525
CONVERTER_HOST_PORT=63100
ADMINER_HOST_PORT=6981

# Public URL used in e-mails and Origin checks (change to https://recruitments.psgtech.ac.in on server).
APP_ORIGIN=http://localhost:6969

# PostgreSQL. The application connects as the least-privilege "srp_app" role; migrations run
# as the owner role. Both roles are created by infrastructure/docker/postgres/init.sh.
POSTGRES_DB=srportal
POSTGRES_USER=srp_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_USER=srp_app
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://srp_app:change-me-app@db:5432/srportal?schema=public
MIGRATION_DATABASE_URL=postgresql://srp_owner:change-me-owner@db:5432/srportal?schema=public

REDIS_URL=redis://redis:6379

# Session secret (>= 32 chars). Cryptographically strong random key for session & CSRF tokens.
SESSION_SECRET=e7b8a1c93f0d4529b68a4e1f7c2d8b5a9034ecbf186241a7d903e15b497c28fa
# Mark cookies Secure. Must be true behind HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Private document storage (container path, backed by a named volume).
STORAGE_DIR=/var/lib/srportal/storage
MAX_UPLOAD_MB=10

# Internal services
CONVERTER_URL=http://converter:3100
CONVERTER_TOKEN=c3f1b8a9d04e762b9a15cd82ef04b971
# clamav = scan with clamd; "disabled" is only allowed when NODE_ENV != production and marks
# every attachment as FAILED scan so bundles cannot be completed silently.
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# E-mail Configuration
# EMAIL_PROVIDER: "mailpit" for local development, "smtp" for production, "test" for automated test mocks.
EMAIL_PROVIDER=mailpit
# Local Mailpit container uses host: "mailpit" (internal Docker) or "localhost" (host dev), port 1025.
# Production requires institutional SMTP host (e.g., smtp.office365.com, mail.psgtech.ac.in, etc.)
SMTP_HOST=mailpit
SMTP_PORT=1025
# SMTP_SECURE: true for SSL/TLS on port 465; false for STARTTLS on port 587 or plain local Mailpit.
SMTP_SECURE=false
# Production credentials (use institutional app-password for recruitments@psgtech.ac.in)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="PSG College of Technology Recruitment"
SMTP_FROM_EMAIL=recruitments@psgtech.ac.in
MAIL_FROM="PSG College of Technology Recruitment <recruitments@psgtech.ac.in>"
# SMTP connection timeouts (milliseconds)
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# 6-Digit Email OTP Authentication Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

LOG_LEVEL=info
# Development only: also print e-mailed sign-in codes to the server log. Rejected when NODE_ENV=production.
DEV_LOG_OTP=false

