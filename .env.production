# ---------------------------------------------------------------------------
# PSG Staff Recruitment Portal — PRODUCTION ENVIRONMENT CONFIGURATION
# Production template. Configure actual private secrets directly on the server.
# Never commit real passwords or private application secrets to Git.
# ---------------------------------------------------------------------------

# Public URL used in e-mails and CSRF Origin checks.
APP_ORIGIN=https://recruitments.psgtech.ac.in

# Host ports (Nginx on host reverse-proxies port 443 -> 127.0.0.1:6969).
APP_HOST_PORT=6969
POSTGRES_HOST_PORT=6543
REDIS_HOST_PORT=63879
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=2525
CONVERTER_HOST_PORT=63100
ADMINER_HOST_PORT=6981

# PostgreSQL credentials & connection strings
POSTGRES_DB=srportal
POSTGRES_USER=srp_owner
POSTGRES_PASSWORD=replace-with-production-owner-password
APP_DB_USER=srp_app
APP_DB_PASSWORD=replace-with-production-app-password
DATABASE_URL=postgresql://srp_app:replace-with-production-app-password@db:5432/srportal?schema=public
MIGRATION_DATABASE_URL=postgresql://srp_owner:replace-with-production-owner-password@db:5432/srportal?schema=public

REDIS_URL=redis://redis:6379

# Session secret (>= 32 chars). Cryptographically strong random key for session & CSRF tokens.
SESSION_SECRET=replace-with-production-session-secret-at-least-32-chars
# Mark cookies Secure (MUST be true behind HTTPS in production).
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Private document storage (container path, backed by a named volume).
STORAGE_DIR=/var/lib/srportal/storage
MAX_UPLOAD_MB=10

# Internal services
CONVERTER_URL=http://converter:3100
CONVERTER_TOKEN=replace-with-production-converter-token
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# E-mail (Production Institutional SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=<institutional-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=recruitments@psgtech.ac.in
SMTP_PASSWORD=<mailbox-app-password>
SMTP_FROM_NAME="PSG College of Technology Recruitment"
SMTP_FROM_EMAIL=recruitments@psgtech.ac.in
MAIL_FROM="PSG College of Technology Recruitment <recruitments@psgtech.ac.in>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# 6-Digit Email OTP Authentication Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

LOG_LEVEL=info
DEV_LOG_OTP=false

