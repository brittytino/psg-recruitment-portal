# ---------------------------------------------------------------------------
# PSG College of Technology — Recruitment Portal: PRODUCTION SETTINGS (committed, no secrets)
# ---------------------------------------------------------------------------
# ./prod.sh builds the real .env from this file on the first run:
#   * every __GENERATED__ value becomes a fresh random secret (kept in .env, never committed)
#   * SMTP_PASSWORD (Gmail app password of recruitments@psgtech.ac.in) is asked once, or read from
#     the SMTP_PASSWORD environment variable or the file secrets/smtp_password
# Later runs add any new settings from this file to .env without touching existing values.
# ---------------------------------------------------------------------------
NODE_ENV=production

# ===========================================================================
# 1. APPLICATION & NETWORK CONFIGURATION
# ===========================================================================
# Public URL used in emails and CSRF Origin validation.
# Dev:  http://localhost:6969
# Prod: https://recruitments.psgtech.ac.in
APP_ORIGIN=https://recruitments.psgtech.ac.in

# Host published ports (Nginx on production host reverse proxies port 443 -> 127.0.0.1:6969)
APP_HOST_PORT=6969
# 127.0.0.1 = reachable only through the reverse proxy (recommended in production)
APP_BIND=127.0.0.1
POSTGRES_HOST_PORT=6543
REDIS_HOST_PORT=63879
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=2525
CONVERTER_HOST_PORT=63100

# Modern Web Database Viewer (pgweb: http://localhost:6981)
DB_VIEWER_HOST_PORT=6981
# Web DB viewer at https://DB_VIEWER_DOMAIN (read-only, password protected).
DB_VIEWER_ENABLED=true
DB_VIEWER_DOMAIN=recruitmentsdb.psgtech.ac.in
# Only these public IPs (space separated; CIDR allowed) can open the DB viewer. Everyone else gets 403.
# 193.149.151.130 = the admin office Wi-Fi. Add more as needed, e.g. "193.149.151.130 14.139.0.0/16".
DB_VIEWER_ALLOW_IPS=193.149.151.130
DB_VIEWER_USER=psgadmin
DB_VIEWER_PASSWORD=__GENERATED__

# ===========================================================================
# 2. POSTGRESQL DATABASE CONFIGURATION
# ===========================================================================
POSTGRES_DB=srportal
POSTGRES_USER=srp_owner
POSTGRES_PASSWORD=__GENERATED__
APP_DB_USER=srp_app
APP_DB_PASSWORD=__GENERATED__

# Connection string used by the web app and worker runtime (least privilege)
DATABASE_URL=postgresql://srp_app:__APP_DB_PASSWORD__@db:5432/srportal?schema=public

# Connection string used by the migration container (schema owner privileges)
MIGRATION_DATABASE_URL=postgresql://srp_owner:__POSTGRES_PASSWORD__@db:5432/srportal?schema=public

# Redis cache and BullMQ job queue
REDIS_URL=redis://redis:6379

# ===========================================================================
# 3. SECURITY & SESSION MANAGEMENT
# ===========================================================================
# Random secret used to sign sessions and CSRF tokens (generated)
SESSION_SECRET=__GENERATED__

# Cookie Secure flag (MUST be true behind HTTPS in production, false for plain HTTP localhost)
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Document storage path inside container (backed by Docker named volume)
STORAGE_DIR=/var/lib/srportal/storage
MAX_UPLOAD_MB=20
# Per-IP rate limits are multiplied by this (the whole campus shares one public IP).
# 30 => e.g. 300 registrations and 900 sign-in requests per IP per hour / 15 min.
IP_RATE_LIMIT_MULTIPLIER=30
# Daily e-mail budget (sign-in codes always go out; routine e-mails stop at 80% of it, then appear
# in the app only). Gmail / Google Workspace accounts allow about 500-2000 per day: stay below.
MAIL_DAILY_BUDGET=450

# ===========================================================================
# 4. INTERNAL MICROSERVICES
# ===========================================================================
CONVERTER_URL=http://converter:3100
CONVERTER_TOKEN=__GENERATED__
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ===========================================================================
# 5. INSTITUTIONAL EMAIL & SMTP DELIVERY
# ===========================================================================
# EMAIL_PROVIDER:
#   "smtp"    — Production: sends live emails via Google Workspace for Education
#   "mailpit" — Development: intercepts all outgoing emails into local web UI (port 8025)
#   "test"    — Unit/Integration testing mock
EMAIL_PROVIDER=smtp

# Google Workspace for Education SMTP Server (recruitments@psgtech.ac.in)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE: false for port 587 (uses STARTTLS); true for port 465 (SSL)
SMTP_SECURE=false
SMTP_USER=recruitments@psgtech.ac.in
SMTP_PASSWORD=
SMTP_FROM_NAME="PSG College of Technology Recruitment"
SMTP_FROM_EMAIL=recruitments@psgtech.ac.in
MAIL_FROM="PSG College of Technology Recruitment <recruitments@psgtech.ac.in>"

# Connection timeouts in milliseconds
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# ===========================================================================
# 6. 6-DIGIT EMAIL OTP AUTHENTICATION
# ===========================================================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# ===========================================================================
# 7. LOGGING & DEBUGGING
# ===========================================================================
LOG_LEVEL=info
DEV_LOG_OTP=false

# ===========================================================================
# 8. SERVER SET-UP (used by ./prod.sh)
# ===========================================================================
# When ./prod.sh runs with root rights it configures Nginx for APP_ORIGIN and DB_VIEWER_DOMAIN.
# HTTPS uses PSG Tech's own certificate (no Let's Encrypt):
#   - Behind the college HTTPS gateway (default): nothing to set; the gateway forwards HTTP to port 80.
#   - Certificate installed on this server: put these two lines in secrets/override.env (server only):
#       SSL_CERTIFICATE=/etc/ssl/psgtech/fullchain.pem
#       SSL_CERTIFICATE_KEY=/etc/ssl/psgtech/private.key
# Set SETUP_NGINX=false if the IT team manages Nginx on this server themselves.
SETUP_NGINX=true
# College gateway / reverse proxy in front of this server: the visitor's real IP is read from its
# X-Forwarded-For header (DB viewer allow-list and rate limits). Space separated IPs or CIDRs.
TRUSTED_PROXY_IPS=10.1.10.162
