// PSG College of Technology — Staff Recruitment Portal
// Schema conventions:
//  - UUID primary keys; human-readable application reference numbers are separate.
//  - All timestamps are timestamptz (UTC).
//  - Submitted revisions, audit events and status history are append-only (enforced by DB triggers
//    created in migration 0002_append_only_triggers).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  HR_OFFICER
  DEPARTMENT_REVIEWER
  RECRUITMENT_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum Position {
  ASSISTANT_PROFESSOR
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

enum FormCode {
  ASSISTANT_PROFESSOR
  ASSOCIATE_PROFESSOR
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_HR_REVIEW
  UNDER_DEPARTMENT_REVIEW
  NEEDS_CLARIFICATION
  SHORTLISTED
  REJECTED
  APPROVED
  WITHDRAWN
}

/// Document processing is tracked separately from the recruitment status (see ADR 0004).
enum ProcessingStatus {
  NOT_STARTED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum DocumentType {
  PHOTOGRAPH
  DEGREE_CERTIFICATE
  MARK_SHEET
  PHD_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  SALARY_CERTIFICATE
  COMMUNITY_CERTIFICATE
  PUBLICATIONS
  NO_OBJECTION_CERTIFICATE
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum GeneratedKind {
  APPLICATION_PDF
  CONSOLIDATED_BUNDLE
}

enum ReviewStage {
  HR
  DEPARTMENT
}

enum Recommendation {
  SHORTLIST
  REJECT
  HOLD
  NEEDS_CLARIFICATION
  APPROVE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  /// Stored lower-cased; unique.
  email            String     @unique
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?  @db.Timestamptz(3)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  roles         UserRole[]
  sessions      Session[]
  tokens        AuthToken[]
  profile       CandidateProfile?
  applications  Application[]       @relation("CandidateApplications")
  assignments   ReviewAssignment[]  @relation("Reviewer")
  reviews       Review[]
  notifications Notification[]
  auditEvents   AuditEvent[]

  @@map("users")
}

/// Role assignment with optional scope. A DEPARTMENT_REVIEWER is scoped to a department;
/// an HR_OFFICER may be scoped to a recruitment cycle (null = all cycles).
model UserRole {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  role         Role
  departmentId String?           @db.Uuid
  cycleId      String?           @db.Uuid
  grantedById  String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id])
  cycle        RecruitmentCycle? @relation(fields: [cycleId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

model Session {
  /// SHA-256 of the opaque session token; the raw token only exists in the HttpOnly cookie.
  id         String   @id
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model CandidateProfile {
  userId           String    @id @db.Uuid
  fullName         String
  phone            String?
  privacyVersion   String
  privacyAcceptedAt DateTime @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String       @unique
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  disciplines Discipline[]
  vacancies   Vacancy[]
  roles       UserRole[]

  @@map("departments")
}

model Discipline {
  id           String     @id @default(uuid()) @db.Uuid
  departmentId String     @db.Uuid
  name         String
  active       Boolean    @default(true)
  department   Department @relation(fields: [departmentId], references: [id])
  vacancies    Vacancy[]

  @@unique([departmentId, name])
  @@map("disciplines")
}

model RecruitmentCycle {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique
  title       String
  description String?
  opensAt     DateTime    @db.Timestamptz(3)
  closesAt    DateTime    @db.Timestamptz(3)
  status      CycleStatus @default(DRAFT)
  publishedAt DateTime?   @db.Timestamptz(3)
  createdById String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  vacancies   Vacancy[]
  roles       UserRole[]

  @@map("recruitment_cycles")
}

model FormTemplate {
  id           String        @id @default(uuid()) @db.Uuid
  code         FormCode
  version      Int
  title        String
  templatePath String
  sha256       String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  vacancies    Vacancy[]
  applications Application[]

  @@unique([code, version])
  @@map("form_templates")
}

model Vacancy {
  id                String                 @id @default(uuid()) @db.Uuid
  /// Human-readable vacancy code shown publicly, e.g. "2026-CSE-AP".
  code              String                 @unique
  cycleId           String                 @db.Uuid
  departmentId      String                 @db.Uuid
  disciplineId      String?                @db.Uuid
  position          Position
  formTemplateId    String                 @db.Uuid
  title             String
  description       String
  numberOfPosts     Int?
  opensAt           DateTime               @db.Timestamptz(3)
  closesAt          DateTime               @db.Timestamptz(3)
  status            VacancyStatus          @default(DRAFT)
  publishedAt       DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  cycle             RecruitmentCycle       @relation(fields: [cycleId], references: [id])
  department        Department             @relation(fields: [departmentId], references: [id])
  discipline        Discipline?            @relation(fields: [disciplineId], references: [id])
  formTemplate      FormTemplate           @relation(fields: [formTemplateId], references: [id])
  eligibility       EligibilityCriterion[]
  requiredDocuments RequiredDocument[]
  applications      Application[]

  @@index([status, closesAt])
  @@index([departmentId])
  @@map("vacancies")
}

model EligibilityCriterion {
  id          String  @id @default(uuid()) @db.Uuid
  vacancyId   String  @db.Uuid
  description String
  sortOrder   Int     @default(0)
  vacancy     Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@map("eligibility_criteria")
}

model RequiredDocument {
  id           String       @id @default(uuid()) @db.Uuid
  vacancyId    String       @db.Uuid
  documentType DocumentType
  label        String
  required     Boolean      @default(true)
  sortOrder    Int          @default(0)
  vacancy      Vacancy      @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, documentType])
  @@map("required_documents")
}

model Application {
  id                  String            @id @default(uuid()) @db.Uuid
  /// Assigned atomically at first submission, e.g. "PSGTECH-2026-000123".
  referenceNo         String?           @unique
  candidateId         String            @db.Uuid
  vacancyId           String            @db.Uuid
  formTemplateId      String            @db.Uuid
  status              ApplicationStatus @default(DRAFT)
  processingStatus    ProcessingStatus  @default(NOT_STARTED)
  /// Current editable answers (only meaningful while DRAFT / NEEDS_CLARIFICATION).
  draftAnswers        Json              @default("{}")
  /// Optimistic concurrency token, incremented on every draft save.
  draftVersion        Int               @default(0)
  lastSavedAt         DateTime?         @db.Timestamptz(3)
  submittedAt         DateTime?         @db.Timestamptz(3)
  currentRevisionId   String?           @unique @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  candidate           User              @relation("CandidateApplications", fields: [candidateId], references: [id])
  vacancy             Vacancy           @relation(fields: [vacancyId], references: [id])
  formTemplate        FormTemplate      @relation(fields: [formTemplateId], references: [id])
  currentRevision     ApplicationRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions           ApplicationRevision[] @relation("Revisions")
  documents           ApplicationDocument[]
  generated           GeneratedDocument[]
  statusHistory       ApplicationStatusHistory[]
  assignments         ReviewAssignment[]
  reviews             Review[]

  /// Policy (pending confirmation): one application per candidate per vacancy.
  @@unique([candidateId, vacancyId])
  @@index([vacancyId, status])
  @@index([status, submittedAt])
  @@index([submittedAt])
  @@map("applications")
}

/// Immutable snapshot of submitted answers and the attachment manifest.
model ApplicationRevision {
  id                 String            @id @default(uuid()) @db.Uuid
  applicationId      String            @db.Uuid
  revisionNo         Int
  formCode           FormCode
  formVersion        Int
  answers            Json
  answersSha256      String
  /// [{documentId, documentType, sha256, sizeBytes, originalName}]
  attachmentManifest Json
  /// Denormalised search fields captured at submission.
  candidateName      String
  createdById        String            @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  application        Application       @relation("Revisions", fields: [applicationId], references: [id])
  currentOf          Application?      @relation("CurrentRevision")
  qualifications     Qualification[]
  employment         EmploymentRecord[]
  generated          GeneratedDocument[]

  @@unique([applicationId, revisionNo])
  @@index([candidateName])
  @@map("application_revisions")
}

/// Normalised academic qualifications extracted from a submitted revision (for HR filtering).
model Qualification {
  id         String              @id @default(uuid()) @db.Uuid
  revisionId String              @db.Uuid
  sortOrder  Int
  level      String?
  degree     String
  university String?
  institution String?
  passedOn    String?
  class       String?
  cgpaOrMarks String?
  attempts    Int?                @default(1)
  revision    ApplicationRevision @relation(fields: [revisionId], references: [id])

  @@index([revisionId])
  @@index([degree])
  @@map("qualifications")
}

/// Normalised employment records extracted from a submitted revision.
model EmploymentRecord {
  id           String              @id @default(uuid()) @db.Uuid
  revisionId   String              @db.Uuid
  sortOrder    Int
  designation  String
  organisation String
  fromDate     String?
  toDate       String?
  nature       String?
  revision     ApplicationRevision @relation(fields: [revisionId], references: [id])

  @@index([revisionId])
  @@map("employment_records")
}

model ApplicationDocument {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @db.Uuid
  documentType  DocumentType
  /// Sanitised display name only; never used as a storage path.
  originalName  String
  /// Random storage identifier (no user-controlled path components).
  storageKey    String       @unique
  mimeType      String
  sizeBytes     Int
  sha256        String
  scanStatus    ScanStatus   @default(PENDING)
  scanDetail    String?
  scannedAt     DateTime?    @db.Timestamptz(3)
  uploadedById  String       @db.Uuid
  uploadedAt    DateTime     @default(now()) @db.Timestamptz(3)
  /// Soft-deleted drafts; documents referenced by a submitted manifest are never removed.
  removedAt     DateTime?    @db.Timestamptz(3)
  application   Application  @relation(fields: [applicationId], references: [id])

  @@index([applicationId, documentType])
  @@map("application_documents")
}

model GeneratedDocument {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  revisionId    String              @db.Uuid
  kind          GeneratedKind
  /// Increments on regeneration; earlier artefacts are kept.
  version       Int
  status        ProcessingStatus    @default(QUEUED)
  storageKey    String?             @unique
  sha256        String?
  sizeBytes     Int?
  pageCount     Int?
  attempts      Int                 @default(0)
  error         String?
  report        Json?
  requestedById String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?           @db.Timestamptz(3)
  application   Application         @relation(fields: [applicationId], references: [id])
  revision      ApplicationRevision @relation(fields: [revisionId], references: [id])

  @@unique([revisionId, kind, version])
  @@index([status])
  @@map("generated_documents")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?            @db.Uuid
  reason        String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  application   Application        @relation(fields: [applicationId], references: [id])

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model ReviewAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  reviewerId    String      @db.Uuid
  stage         ReviewStage
  assignedById  String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?   @db.Timestamptz(3)
  application   Application @relation(fields: [applicationId], references: [id])
  reviewer      User        @relation("Reviewer", fields: [reviewerId], references: [id])
  reviews       Review[]

  @@unique([applicationId, reviewerId, stage])
  @@index([reviewerId])
  @@map("review_assignments")
}

model Review {
  id             String            @id @default(uuid()) @db.Uuid
  applicationId  String            @db.Uuid
  reviewerId     String            @db.Uuid
  assignmentId   String?           @db.Uuid
  stage          ReviewStage
  recommendation Recommendation
  score          Int?
  comments       String
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  application    Application       @relation(fields: [applicationId], references: [id])
  reviewer       User              @relation(fields: [reviewerId], references: [id])
  assignment     ReviewAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([applicationId])
  @@map("reviews")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  /// Never contains passwords, tokens, full answers or document contents.
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      String
  subject   String
  body      String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  error     String?
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  sentAt    DateTime?          @db.Timestamptz(3)
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Transactional outbox: written in the same transaction as the state change, then relayed
/// to BullMQ by the worker. Guarantees jobs/notifications are never lost or sent for a
/// rolled-back change (ADR 0005).
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  availableAt DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

/// Per-year counter used to allocate application reference numbers without gaps under concurrency.
model ReferenceCounter {
  year  Int @id
  value Int @default(0)

  @@map("reference_counters")
}
