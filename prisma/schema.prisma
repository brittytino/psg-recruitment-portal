// PSG College of Technology — Staff Recruitment Portal
// Schema conventions:
//  - UUID primary keys; human-readable application reference numbers are separate.
//  - All timestamps are timestamptz (UTC).
//  - Submitted revisions, audit events and status history are append-only (enforced by DB triggers
//    created in migration 0002_append_only_triggers).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// SUPER_ADMIN = system administrator (full access: system config, audit logs, users, roles, settings).
/// ADMIN = Dean / Principal (recruitment administration, bulk assignment, review, summary sheets).
/// HR = HR – N4 Section (job profiles, screening, departments, HODs, specialisations, notices).
/// HOD = department reviewer, scoped to authorized departments.
enum Role {
  CANDIDATE
  HR
  HOD
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OtpPurpose {
  STAFF_LOGIN
  EMAIL_VERIFICATION
  LOGIN
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// Faculty positions (Professor cadre). Research positions use a configurable title stored on the vacancy.
enum Position {
  ASSISTANT_PROFESSOR
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

/// Distinguishes the two recruitment workflows. Enforced in backend services, not just UI.
enum RecruitmentCategory {
  FACULTY
  RESEARCH
}

enum FormCode {
  ASSISTANT_PROFESSOR
  ASSOCIATE_PROFESSOR
  RESEARCH_APPLICATION
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_HR_REVIEW
  UNDER_DEPARTMENT_REVIEW
  NEEDS_CLARIFICATION
  SHORTLISTED
  REJECTED
  APPROVED
  WITHDRAWN
  ASSIGNED_TO_HOD
  HOD_ACCEPTED
  HOD_RECOMMENDED_CHANGE
  HOD_REJECTED
}

enum HodDecision {
  ACCEPT
  RECOMMEND_CHANGE
  REJECT
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SummarySheetStatus {
  APPROVED
  SUPERSEDED
}

/// Document processing is tracked separately from the recruitment status (see ADR 0004).
enum ProcessingStatus {
  NOT_STARTED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum DocumentType {
  PHOTOGRAPH
  DEGREE_CERTIFICATE
  MARK_SHEET
  PHD_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  SALARY_CERTIFICATE
  COMMUNITY_CERTIFICATE
  PUBLICATIONS
  NO_OBJECTION_CERTIFICATE
  OTHER
  SIGNATURE
  RESUME
  APPOINTMENT_ORDER
  SALARY_SLIP
  SERVICE_CERTIFICATE
  MEMBERSHIP_CERTIFICATE
  PUBLICATION_PROOF
  COMPETITIVE_EXAM_SCORECARD
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum GeneratedKind {
  APPLICATION_PDF
  CONSOLIDATED_BUNDLE
}

enum ReviewStage {
  HR
  DEPARTMENT
}

enum Recommendation {
  SHORTLIST
  REJECT
  HOLD
  NEEDS_CLARIFICATION
  APPROVE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  /// Stored lower-cased; unique.
  email            String     @unique
  passwordHash     String?
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?  @db.Timestamptz(3)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  roles           UserRole[]
  sessions        Session[]
  tokens          AuthToken[]
  profile         CandidateProfile?
  applications    Application[]      @relation("CandidateApplications")
  assignments     ReviewAssignment[] @relation("Reviewer")
  reviews         Review[]
  notifications   Notification[]
  auditEvents     AuditEvent[]
  otps            OtpChallenge[]
  hodApplications Application[]      @relation("AssignedHod")
  /// Last column selection used for the summary CSV export (per-user convenience).
  exportColumns   Json?

  @@map("users")
}

/// Role assignment. A HOD is scoped to a department (one row per department).
model UserRole {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  role         Role
  departmentId String?     @db.Uuid
  grantedById  String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

model Session {
  /// SHA-256 of the opaque session token; the raw token only exists in the HttpOnly cookie.
  id         String   @id
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time e-mail code (6 digits). Only an HMAC of the code is stored; single use, 10 minutes,
/// at most 5 verification attempts.
model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.Timestamptz(3)
  consumedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  ip         String?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_challenges")
}

/// Small key/value store for Admin-configurable settings (e.g. OTP for HOD sign-in).
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_settings")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model CandidateProfile {
  userId            String   @id @db.Uuid
  fullName          String
  phone             String?
  privacyVersion    String
  privacyAcceptedAt DateTime @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Department {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String         @unique
  description   String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  disciplines   Discipline[]
  vacancies     Vacancy[]
  roles         UserRole[]
  applications  Application[]
  summarySheets SummarySheet[]

  @@map("departments")
}

model Discipline {
  id           String     @id @default(uuid()) @db.Uuid
  departmentId String     @db.Uuid
  name         String
  active       Boolean    @default(true)
  department   Department @relation(fields: [departmentId], references: [id])
  vacancies    Vacancy[]

  @@unique([departmentId, name])
  @@map("disciplines")
}

/// Configurable research specialisations managed by N4 HR through the admin interface.
/// The initial set matches the official poster; HR can add, edit, activate and deactivate.
model ResearchSpecialisation {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  vacancies   Vacancy[]

  @@index([active, sortOrder])
  @@map("research_specialisations")
}

model FormTemplate {
  id           String        @id @default(uuid()) @db.Uuid
  code         FormCode
  version      Int
  title        String
  templatePath String
  sha256       String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  vacancies    Vacancy[]
  applications Application[]

  @@unique([code, version])
  @@map("form_templates")
}

model Vacancy {
  id                       String                  @id @default(uuid()) @db.Uuid
  /// Human-readable vacancy code shown publicly, e.g. "2026-CSE-AP" or "2026-RA-EV".
  code                     String                  @unique
  /// Academic year used in reference numbers, e.g. "2026-27" (derived from the opening date when empty).
  academicYear             String?
  /// Faculty vacancies require a department; research vacancies may leave this null.
  departmentId             String?                 @db.Uuid
  disciplineId             String?                 @db.Uuid
  /// Faculty cadre position (null for research vacancies).
  position                 Position?
  formTemplateId           String                  @db.Uuid
  title                    String
  description              String
  numberOfPosts            Int?
  opensAt                  DateTime                @db.Timestamptz(3)
  closesAt                 DateTime                @db.Timestamptz(3)
  status                   VacancyStatus           @default(DRAFT)
  publishedAt              DateTime?               @db.Timestamptz(3)
  /// Determines which workflow applies (faculty with HOD review, or research with HR-only review).
  recruitmentCategory      RecruitmentCategory     @default(FACULTY)
  /// Configurable position title for research vacancies (e.g. "Research Assistant" or "Research Associate").
  researchPositionTitle    String?
  researchSpecialisationId String?                 @db.Uuid
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)
  department               Department?             @relation(fields: [departmentId], references: [id])
  discipline               Discipline?             @relation(fields: [disciplineId], references: [id])
  formTemplate             FormTemplate            @relation(fields: [formTemplateId], references: [id])
  researchSpecialisation   ResearchSpecialisation? @relation(fields: [researchSpecialisationId], references: [id])
  eligibility              EligibilityCriterion[]
  requiredDocuments        RequiredDocument[]
  applications             Application[]

  @@index([status, closesAt])
  @@index([departmentId])
  @@index([recruitmentCategory, status])
  @@map("vacancies")
}

model EligibilityCriterion {
  id          String  @id @default(uuid()) @db.Uuid
  vacancyId   String  @db.Uuid
  description String
  sortOrder   Int     @default(0)
  vacancy     Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@map("eligibility_criteria")
}

model RequiredDocument {
  id           String       @id @default(uuid()) @db.Uuid
  vacancyId    String       @db.Uuid
  documentType DocumentType
  label        String
  required     Boolean      @default(true)
  sortOrder    Int          @default(0)
  vacancy      Vacancy      @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, documentType])
  @@map("required_documents")
}

model Application {
  id                   String                     @id @default(uuid()) @db.Uuid
  /// Assigned atomically at first submission, e.g. "PSGCT2026-27CSE_0001" or "PSGCT2026-27RA_0001".
  referenceNo          String?                    @unique
  candidateId          String                     @db.Uuid
  vacancyId            String                     @db.Uuid
  formTemplateId       String                     @db.Uuid
  status               ApplicationStatus          @default(DRAFT)
  processingStatus     ProcessingStatus           @default(NOT_STARTED)
  /// Current editable answers (only meaningful while DRAFT / NEEDS_CLARIFICATION).
  draftAnswers         Json                       @default("{}")
  /// Optimistic concurrency token, incremented on every draft save.
  draftVersion         Int                        @default(0)
  lastSavedAt          DateTime?                  @db.Timestamptz(3)
  submittedAt          DateTime?                  @db.Timestamptz(3)
  currentRevisionId    String?                    @unique @db.Uuid
  /// Denormalised from the vacancy for department-scoped queries.
  departmentId         String?                    @db.Uuid
  /// Denormalised recruitment category for explicit workflow routing.
  recruitmentCategory  RecruitmentCategory        @default(FACULTY)
  /// What the candidate applied for. Never changed after creation. Null for research applications.
  appliedPosition      Position?
  /// Set only when Admin approves a HOD's position-change recommendation.
  effectivePosition    Position?
  assignedHodId        String?                    @db.Uuid
  assignedAt           DateTime?                  @db.Timestamptz(3)
  hodDecision          HodDecision?
  hodDecisionReason    String?
  hodRemarks           String?
  hodDecidedAt         DateTime?                  @db.Timestamptz(3)
  /// Internal review note recorded by N4 HR (never visible to candidates).
  internalNote         String?
  /// Interview call sent by HR – N4 Section after the department review (e-mailed to the candidate).
  interviewAt          DateTime?                  @db.Timestamptz(3)
  interviewVenue       String?
  interviewNotes       String?
  interviewInvitedAt   DateTime?                  @db.Timestamptz(3)
  interviewInvitedById String?                    @db.Uuid
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  department           Department?                @relation(fields: [departmentId], references: [id])
  assignedHod          User?                      @relation("AssignedHod", fields: [assignedHodId], references: [id])
  positionChanges      PositionChangeRequest[]
  candidate            User                       @relation("CandidateApplications", fields: [candidateId], references: [id])
  vacancy              Vacancy                    @relation(fields: [vacancyId], references: [id])
  formTemplate         FormTemplate               @relation(fields: [formTemplateId], references: [id])
  currentRevision      ApplicationRevision?       @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions            ApplicationRevision[]      @relation("Revisions")
  documents            ApplicationDocument[]
  generated            GeneratedDocument[]
  statusHistory        ApplicationStatusHistory[]
  assignments          ReviewAssignment[]
  reviews              Review[]

  /// Policy (pending confirmation): one application per candidate per vacancy.
  @@unique([candidateId, vacancyId])
  @@index([vacancyId, status])
  @@index([status, submittedAt])
  @@index([submittedAt])
  @@index([departmentId, status])
  @@index([assignedHodId, status])
  @@index([recruitmentCategory, status])
  @@map("applications")
}

/// Immutable snapshot of submitted answers and the attachment manifest.
model ApplicationRevision {
  id                    String              @id @default(uuid()) @db.Uuid
  applicationId         String              @db.Uuid
  revisionNo            Int
  formCode              FormCode
  formVersion           Int
  answers               Json
  answersSha256         String
  /// [{documentId, documentType, sha256, sizeBytes, originalName}]
  attachmentManifest    Json
  /// Denormalised search fields captured at submission.
  candidateName         String
  /// Filter fields captured at submission (HR dashboard filters and exports).
  phdStatus             String?
  hasPhd                Boolean             @default(false)
  competitiveExams      String[]            @default([])
  totalExperienceMonths Int?
  journalCount          Int?
  conferenceCount       Int?
  hIndex                Int?
  createdById           String              @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  application           Application         @relation("Revisions", fields: [applicationId], references: [id])
  currentOf             Application?        @relation("CurrentRevision")
  qualifications        Qualification[]
  employment            EmploymentRecord[]
  generated             GeneratedDocument[]

  @@unique([applicationId, revisionNo])
  @@index([candidateName])
  @@map("application_revisions")
}

/// Normalised academic qualifications extracted from a submitted revision (for HR filtering).
model Qualification {
  id             String              @id @default(uuid()) @db.Uuid
  revisionId     String              @db.Uuid
  sortOrder      Int
  level          String?
  degree         String
  university     String?
  institution    String?
  passedOn       String?
  attempts       Int?                @default(1)
  /// SCHOOL or COLLEGE (v2 forms).
  category       String?
  board          String?
  specialisation String?
  score          String?
  classAwarded   String?
  class          String?
  cgpaOrMarks    String?
  modeOfStudy    String?
  revision       ApplicationRevision @relation(fields: [revisionId], references: [id])

  @@index([revisionId])
  @@index([degree])
  @@map("qualifications")
}

/// Normalised employment records extracted from a submitted revision.
model EmploymentRecord {
  id             String              @id @default(uuid()) @db.Uuid
  revisionId     String              @db.Uuid
  sortOrder      Int
  designation    String
  organisation   String
  fromDate       String?
  toDate         String?
  nature         String?
  isCurrent      Boolean             @default(false)
  scaleOfPay     String?
  grossSalary    String?
  durationMonths Int?
  revision       ApplicationRevision @relation(fields: [revisionId], references: [id])

  @@index([revisionId])
  @@map("employment_records")
}

model ApplicationDocument {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @db.Uuid
  documentType  DocumentType
  /// Sanitised display name only; never used as a storage path.
  originalName  String
  /// Random storage identifier (no user-controlled path components).
  storageKey    String       @unique
  mimeType      String
  sizeBytes     Int
  sha256        String
  scanStatus    ScanStatus   @default(PENDING)
  scanDetail    String?
  scannedAt     DateTime?    @db.Timestamptz(3)
  uploadedById  String       @db.Uuid
  uploadedAt    DateTime     @default(now()) @db.Timestamptz(3)
  /// Soft-deleted drafts; documents referenced by a submitted manifest are never removed.
  removedAt     DateTime?    @db.Timestamptz(3)
  application   Application  @relation(fields: [applicationId], references: [id])

  @@index([applicationId, documentType])
  @@map("application_documents")
}

model GeneratedDocument {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  revisionId    String              @db.Uuid
  kind          GeneratedKind
  /// Increments on regeneration; earlier artefacts are kept.
  version       Int
  status        ProcessingStatus    @default(QUEUED)
  storageKey    String?             @unique
  sha256        String?
  sizeBytes     Int?
  pageCount     Int?
  attempts      Int                 @default(0)
  error         String?
  report        Json?
  requestedById String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?           @db.Timestamptz(3)
  application   Application         @relation(fields: [applicationId], references: [id])
  revision      ApplicationRevision @relation(fields: [revisionId], references: [id])

  @@unique([revisionId, kind, version])
  @@index([status])
  @@map("generated_documents")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?            @db.Uuid
  reason        String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  application   Application        @relation(fields: [applicationId], references: [id])

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model ReviewAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  reviewerId    String      @db.Uuid
  stage         ReviewStage
  assignedById  String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?   @db.Timestamptz(3)
  application   Application @relation(fields: [applicationId], references: [id])
  reviewer      User        @relation("Reviewer", fields: [reviewerId], references: [id])
  reviews       Review[]

  @@unique([applicationId, reviewerId, stage])
  @@index([reviewerId])
  @@map("review_assignments")
}

model Review {
  id             String            @id @default(uuid()) @db.Uuid
  applicationId  String            @db.Uuid
  reviewerId     String            @db.Uuid
  assignmentId   String?           @db.Uuid
  stage          ReviewStage
  recommendation Recommendation
  score          Int?
  comments       String
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  application    Application       @relation(fields: [applicationId], references: [id])
  reviewer       User              @relation(fields: [reviewerId], references: [id])
  assignment     ReviewAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([applicationId])
  @@map("reviews")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  /// Never contains passwords, tokens, full answers or document contents.
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      String
  subject   String
  body      String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  error     String?
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  sentAt    DateTime?          @db.Timestamptz(3)
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Transactional outbox: written in the same transaction as the state change, then relayed
/// to BullMQ by the worker. Guarantees jobs/notifications are never lost or sent for a
/// rolled-back change (ADR 0005).
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  availableAt DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

/// Legacy per-year counter (references issued before the department-wise "PSGCT" format).
model ReferenceCounter {
  year  Int @id
  value Int @default(0)

  @@map("reference_counters")
}

/// Running number per academic year and department for "PSGCT<year><DEPT>_<NNNN>" references.
model DepartmentReferenceCounter {
  academicYear   String
  departmentCode String
  value          Int    @default(0)

  @@id([academicYear, departmentCode])
  @@map("department_reference_counters")
}

/// Running number per academic year for research application references: "PSGCT<year>RA_<NNNN>".
model ResearchReferenceCounter {
  academicYear String @id
  value        Int    @default(0)

  @@map("research_reference_counters")
}

/// A HOD's recommendation to consider an application for a different position. The submitted
/// revision is never changed; Admin approval sets Application.effectivePosition.
model PositionChangeRequest {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  fromPosition  Position
  toPosition    Position
  reason        String
  requestedById String              @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  status        ChangeRequestStatus @default(PENDING)
  decidedById   String?             @db.Uuid
  decidedAt     DateTime?           @db.Timestamptz(3)
  decisionNote  String?
  application   Application         @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@map("position_change_requests")
}

/// Immutable, versioned snapshot of a department's HOD decisions, approved by the HOD.
/// Regenerating creates a new version and marks the previous one SUPERSEDED.
model SummarySheet {
  id           String             @id @default(uuid()) @db.Uuid
  departmentId String             @db.Uuid
  academicYear String
  version      Int
  status       SummarySheetStatus @default(APPROVED)
  /// [{sNo, applicationId, referenceNo, candidateName, appliedFor, recommendedFor, decision, reason, status}]
  rows         Json
  approvedById String             @db.Uuid
  approvedAt   DateTime           @default(now()) @db.Timestamptz(3)
  department   Department         @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, academicYear, version])
  @@index([status])
  @@map("summary_sheets")
}

/// PDF notice uploaded by HR – N4 Section and linked from the landing page ("Open positions").
model PublicNotice {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  originalName String
  storageKey   String   @unique
  sizeBytes    Int
  sha256       String
  active       Boolean  @default(true)
  uploadedById String   @db.Uuid
  uploadedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([active, uploadedAt])
  @@map("public_notices")
}
